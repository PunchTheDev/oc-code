+  .strict();
+
+const EndpointProviderScoreSchema = z
+  .object({
+    provider: z.string(),
+    endpoint_count: z.int().min(0),
+    monitored_count: z.int().min(0),
+    ok_count: z.int().min(0),
+    failed_count: z.int().min(0),
+    degraded_count: z.int().min(0),
+    pool_eligible_count: z.int().min(0),
