+    networks: z.array(RpcUsageNetworkRowSchema),
+    buckets: z.array(RpcUsageBucketSchema),
+  })
+  .passthrough();
+export type RpcUsageArtifact = z.infer<typeof RpcUsageArtifactSchema>;
