+    assert_eq!(
+        expression("what is three point five plus two point five"),
+        "3.5 + 2.5"
+    );
+    assert_eq!(
+        expression("what is twelve point five percent of 80"),
+        "80 * 12.5 / 100"
+    );
+    assert_eq!(
+        expression("convert ninety eight point six f to celsius"),
+        "(98.6 - 32) * 5 / 9"
+    );
+}
