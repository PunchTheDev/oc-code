+  }
+
+  [data-mobile-action-left] [data-combat-phase-indicator] button svg {
+    height: 0.625rem;
+    width: 0.625rem;
+  }
+
+  [data-mobile-action-left] [data-combat-phase-indicator] button > span {
+    transform: scale(0.85);
+  }
+
+  [data-flex-zone="actionRail"] {
+    right: 0 !important;
