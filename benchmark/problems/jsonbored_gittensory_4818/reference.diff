+  calibrationStatus,
+  calibrationTrendValues,
+  type GateCalibration,
+} from "@/components/site/app-panels/calibration-card-model";
+
+function emptyBins() {
+  return [
+    {
+      label: "50–60%",
+      minConfidence: 0.5,
+      maxConfidence: 0.6,
+      sampleSize: 0,
+      keptCount: 0,
+      revertedCount: 0,
+      keptRate: null,
+    },
+    {
+      label: "60–70%",
+      minConfidence: 0.6,
+      maxConfidence: 0.7,
+      sampleSize: 0,
+      keptCount: 0,
+      revertedCount: 0,
+      keptRate: null,
+    },
+    {
+      label: "70–80%",
+      minConfidence: 0.7,
+      maxConfidence: 0.8,
+      sampleSize: 0,
+      keptCount: 0,
+      revertedCount: 0,
+      keptRate: null,
+    },
+    {
+      label: "80–90%",
+      minConfidence: 0.8,
+      maxConfidence: 0.9,
+      sampleSize: 0,
+      keptCount: 0,
+      revertedCount: 0,
+      keptRate: null,
+    },
+    {
+      label: "90–100%",
+      minConfidence: 0.9,
+      maxConfidence: 1,
+      sampleSize: 0,
+      keptCount: 0,
+      revertedCount: 0,
+      keptRate: null,
+    },
+  ];
+}
+
+function calibration(overrides: Partial<GateCalibration> = {}): GateCalibration {
+  return {
+    currentFloor: 0.9,
+    mergedCount: 0,
+    revertedCount: 0,
+    keptAvgConfidence: null,
+    revertedMaxConfidence: null,
+    recommendedFloor: null,
+    note: "No reverted auto-merges — the current floor looks adequate.",
