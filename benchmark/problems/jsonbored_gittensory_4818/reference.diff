+          label: "80–90%",
+          minConfidence: 0.8,
+          maxConfidence: 0.9,
+          sampleSize: 2,
+          keptCount: 2,
+          revertedCount: 0,
+          keptRate: 1,
+        },
+        {
+          label: "90–100%",
+          minConfidence: 0.9,
+          maxConfidence: 1,
+          sampleSize: 2,
+          keptCount: 1,
+          revertedCount: 1,
+          keptRate: 0.5,
+        },
+      ]),
+    ).toEqual([100, 50]);
+  });
+});
