+                    method=method,
+                    headers={
+                        "Sec-Fetch-Site": "cross-site",
+                        "Origin": "https://evil.example.com",
+                    },
+                )
+                self.assertEqual(response.code, 200)
+
+    def test_other_unsafe_methods_checked(self):
+        # Methods without a handler would return 405, but the origin check
