+      it 'registers offenses for all the assignments' do
+        expect_offense(<<~RUBY)
+          def some_method
+            foo = 1
+            ^^^ Useless assignment to variable - `foo`.
+            foo = 2
+            ^^^ Useless assignment to variable - `foo`.
+            bar {
+              foo = 3
