+      },
+      "d-real.test.ts": {
+        "real": "passed",
+      },
+      "e-autospy.test.ts": {
+        "autospy": "passed",
+      },
+      "f-import-original.test.ts": {
+        "importOriginal": "passed",
+      },
+      "g-redirect.test.ts": {
+        "__mocks__": "passed",
+      },
+      "h-real.test.ts": {
+        "real": "passed",
+      },
+      "i-unused-do-mock.test.ts": {
+        "mock is never imported": "passed",
+      },
+      "j-real.test.ts": {
+        "real": "passed",
+      },
+      "k-import-mock.test.ts": {
+        "importMock": "passed",
+      },
+      "l-real.test.ts": {
+        "real": "passed",
+      },
+    }
+  `)
+})
