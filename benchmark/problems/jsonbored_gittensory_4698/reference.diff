+    expect(DEFAULT_AUTO_APPLY_MIN_SCORE).toBeGreaterThan(0.65);
+    expect(DEFAULT_AUTO_APPLY_MIN_SCORE).toBeLessThanOrEqual(1);
+  });
+});
