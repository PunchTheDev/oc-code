+      if (url.includes("/milestones")) return Response.json([{ number: 20, title: MILESTONE_TITLE }]);
+      if (url.endsWith("/graphql")) return Response.json(noOpenProjectsGraphQlBody());
+      if (url.includes("/issues/4/comments") && method === "POST") {
