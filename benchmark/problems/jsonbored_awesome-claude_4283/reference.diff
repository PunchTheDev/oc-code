-  if (job.source === "curated") labels.add("Editorially curated");
-  if (job.claimedEmployer) labels.add("Claimed employer");
-  if (job.isRemote) labels.add("Remote");
-  if (job.compensation) labels.add("Compensation listed");
-  return [...labels];
