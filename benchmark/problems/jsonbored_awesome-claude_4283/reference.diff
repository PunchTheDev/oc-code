-
-function latestJobTimestamp(jobs: PublicJobListing[]) {
-  const timestamps = jobs
-    .flatMap((job) => [
-      job.lastVerifiedAt,
-      job.sourceCheckedAt,
-      job.lastCheckedAt,
-      job.postedAt,
-      job.firstSeenAt,
