+function seedEligibilityFired(
+  ledger: EventLedger,
+  issueNumber: number,
+  ruleId: string,
+  metadata: Record<string, unknown> | undefined,
+  occurredAt: string,
+) {
+  ledger.appendEvent({
+    type: SIGNAL_RULE_FIRED_EVENT,
+    repoFullName: "acme/widgets",
+    payload: {
+      ruleId,
+      targetKey: `acme/widgets#issue-${issueNumber}`,
+      outcome: "exclude",
+      occurredAt,
+      ...(metadata ? { metadata } : {}),
+    },
+  });
