+  occurredAt: string,
+) {
+  ledger.appendEvent({
+    type: SIGNAL_HUMAN_OVERRIDE_EVENT,
+    repoFullName: "acme/widgets",
+    payload: {
+      ruleId,
+      targetKey: `acme/widgets#issue-${issueNumber}`,
+      verdict,
+      occurredAt,
+    },
+  });
