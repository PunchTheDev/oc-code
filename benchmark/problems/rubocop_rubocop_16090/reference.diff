diff --git a/lib/rubocop/cop/lint/safe_navigation_consistency.rb b/lib/rubocop/cop/lint/safe_navigation_consistency.rb
index cf49490dee4f..86ec04ddadee 100644
--- a/lib/rubocop/cop/lint/safe_navigation_consistency.rb
+++ b/lib/rubocop/cop/lint/safe_navigation_consistency.rb
@@ -60,7 +60,7 @@ def on_and(node)
 
             rest_operands = grouped_operands[begin_of_rest_operands..]
             rest_operands.each do |operand|
-              next if already_appropriate_call?(operand, dot_op)
+              next unless correction_needed?(operand, dot_op, grouped_operands)
 
               register_offense(operand, dot_op)
             end
@@ -100,12 +100,58 @@ def find_consistent_parts(grouped_operands)
           end
         end
 
+        def correction_needed?(operand, dot_op, grouped_operands)
+          return false if already_appropriate_call?(operand, dot_op)
+
+          dot_op == '&.' || receiver_guaranteed?(operand, grouped_operands)
+        end
+
         def already_appropriate_call?(operand, dot_op)
           return true if operand.safe_navigation? && dot_op == '&.'
 
           (operand.dot? || operand.operator_method?) && dot_op == '.'
         end
 
+        def receiver_guaranteed?(operand, grouped_operands)
+          grouped_operands.take_while { |guard| !guard.equal?(operand) }.any? do |guard|
+            guaranteed_by?(guard, operand)
+          end
+        end
+
+        def guaranteed_by?(guard, operand)
+          return false unless (path = logical_path(guard, operand))
+
+          truthiness = path.last.first.and_type? ? :truthy : :falsey
+          path[0...-1].reverse_each do |node, child|
+            return false unless (truthiness = child_truthiness(node, child, truthiness))
+          end
+
+          !guard.csend_type? || truthiness == :truthy
+        end
+
+        def logical_path(guard, operand)
+          path = []
+          child = guard
+
+          guard.each_ancestor do |node|
+            unless node.begin_type?
+              return nil unless node.operator_keyword?
+
+              path << [node, child]
+            end
+            return path if operand.each_ancestor.any? { |ancestor| ancestor.equal?(node) }
+
+            child = node
+          end
+        end
+
+        def child_truthiness(node, child, truthiness)
+          deciding = node.and_type? ? :truthy : :falsey
+          return truthiness == deciding ? deciding : :unknown if node.lhs.equal?(child)
+
+          deciding if truthiness == deciding
+        end
+
         def register_offense(operand, dot_operator)
           offense_range = operand.operator_method? ? operand : operand.loc.dot
           message = dot_operator == '.' ? USE_DOT_MSG : USE_SAFE_NAVIGATION_MSG
diff --git a/spec/rubocop/cop/lint/safe_navigation_consistency_spec.rb b/spec/rubocop/cop/lint/safe_navigation_consistency_spec.rb
index db85d50bf4ab..c4f708223fc5 100644
--- a/spec/rubocop/cop/lint/safe_navigation_consistency_spec.rb
+++ b/spec/rubocop/cop/lint/safe_navigation_consistency_spec.rb
@@ -341,4 +341,38 @@
       foo&.bar && foo.baz || foo.qux
     RUBY
   end
+
+  it 'does not register an offense when safe navigation is used in both `&&` branches of `||`' do
+    expect_no_offenses(<<~RUBY)
+      bar && foo&.baz || qux && foo&.baz
+    RUBY
+  end
+
+  it 'does not register an offense when the dot method call is not always evaluated before safe navigation' do
+    expect_no_offenses(<<~RUBY)
+      bar && foo.baz || foo&.qux
+    RUBY
+  end
+
+  it 'registers an offense and corrects when the dot method call is always evaluated before safe navigation' do
+    expect_offense(<<~RUBY)
+      foo.bar && baz || foo&.qux
+                           ^^ Use `.` instead of unnecessary `&.`.
+    RUBY
+
+    expect_correction(<<~RUBY)
+      foo.bar && baz || foo.qux
+    RUBY
+  end
+
+  it 'registers an offense and corrects when the dot method call must have been evaluated for safe navigation to be reached' do
+    expect_offense(<<~RUBY)
+      bar || foo.baz && qux || foo&.quux
+                                  ^^ Use `.` instead of unnecessary `&.`.
+    RUBY
+
+    expect_correction(<<~RUBY)
+      bar || foo.baz && qux || foo.quux
+    RUBY
+  end
 end
