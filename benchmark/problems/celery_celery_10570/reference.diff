+    def test_survives_unusable_connection(self):
+        # Best effort: teardown must carry on to close() regardless.
+        class Unusable:
+            @property
+            def transport(self):
+                raise OSError('connection is gone')
+
+        bound_open_broker_sockets(Unusable(), 5.0)
