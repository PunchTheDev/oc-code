diff --git a/changelog/fix_false_positives_for_style_redundant_current_directory_in_path.md b/changelog/fix_false_positives_for_style_redundant_current_directory_in_path.md
new file mode 100644
index 000000000000..8ae8fca950de
--- /dev/null
