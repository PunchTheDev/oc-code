+def test_ledger_cost_gate_passes_when_totals_match(tmp_path: Path):
+    ledger = tmp_path / "ledger.jsonl"
+    CL.append_ledger_entry(ledger, "qwen3.5-35b-a3b", 2_000_000, 500_000)
