+    # columns). It is a disposable index over the Qdrant cache, so drop the old
+    # table and let the schema recreate it with the current columns.
+    ("DROP TABLE IF EXISTS llm_cache",),
+]
+SCHEMA_VERSION = len(_MIGRATIONS)
+
 
