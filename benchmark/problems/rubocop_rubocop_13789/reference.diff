diff --git a/changelog/fix_incorrect_autocorrect_for_style_explicit_block_argument.md b/changelog/fix_incorrect_autocorrect_for_style_explicit_block_argument.md
new file mode 100644
index 000000000000..0e0bf3091c36
--- /dev/null
+++ b/changelog/fix_incorrect_autocorrect_for_style_explicit_block_argument.md
@@ -0,0 +1 @@
+* [#13787](https://github.com/rubocop/rubocop/issues/13787): Fix incorrect autocorrect for `Style/ExplicitBlockArgument` when using arguments of `zsuper` in method definition. ([@koic][])
diff --git a/lib/rubocop/cop/style/explicit_block_argument.rb b/lib/rubocop/cop/style/explicit_block_argument.rb
index 6f5bd840496e..907c48b468e1 100644
--- a/lib/rubocop/cop/style/explicit_block_argument.rb
+++ b/lib/rubocop/cop/style/explicit_block_argument.rb
@@ -135,7 +135,13 @@ def insert_argument(node, corrector, block_name)
         end
 
         def correct_call_node(node, corrector, block_name)
-          corrector.insert_after(node, "(&#{block_name})")
+          new_arguments = if node.zsuper_type?
+                            args = build_new_arguments_for_zsuper(node) << "&#{block_name}"
+                            args.join(', ')
+                          else
+                            "&#{block_name}"
+                          end
+          corrector.insert_after(node, "(#{new_arguments})")
           return unless node.parenthesized?
 
           args_begin = Util.args_begin(node)
@@ -144,6 +150,13 @@ def correct_call_node(node, corrector, block_name)
           corrector.remove(range)
         end
 
+        def build_new_arguments_for_zsuper(node)
+          def_node = node.each_ancestor(:def, :defs).first
+          def_node.arguments.map do |arg|
+            arg.optarg_type? ? arg.node_parts[0] : arg.source
+          end
+        end
+
         def block_body_range(block_node, send_node)
           range_between(send_node.source_range.end_pos, block_node.loc.end.end_pos)
         end
diff --git a/spec/rubocop/cop/style/explicit_block_argument_spec.rb b/spec/rubocop/cop/style/explicit_block_argument_spec.rb
index 4bceb9bdc171..5f0ae77779ef 100644
--- a/spec/rubocop/cop/style/explicit_block_argument_spec.rb
+++ b/spec/rubocop/cop/style/explicit_block_argument_spec.rb
@@ -236,4 +236,34 @@ def my_method(x, &block)
       end
     RUBY
   end
+
+  it 'registers an offense when using arguments with zsuper in a method definition' do
+    expect_offense(<<~RUBY)
+      def my_method(x, y = 42, *args, **options)
+        super { yield }
+        ^^^^^^^^^^^^^^^ Consider using explicit block argument in the surrounding method's signature over `yield`.
+      end
+    RUBY
+
+    expect_correction(<<~RUBY)
+      def my_method(x, y = 42, *args, **options, &block)
+        super(x, y, *args, **options, &block)
+      end
+    RUBY
+  end
+
+  it 'registers an offense when using arguments with zsuper in a singleton method definition' do
+    expect_offense(<<~RUBY)
+      def self.my_method(x, y = 42, *args, **options)
+        super { yield }
+        ^^^^^^^^^^^^^^^ Consider using explicit block argument in the surrounding method's signature over `yield`.
+      end
+    RUBY
+
+    expect_correction(<<~RUBY)
+      def self.my_method(x, y = 42, *args, **options, &block)
+        super(x, y, *args, **options, &block)
+      end
+    RUBY
+  end
 end
