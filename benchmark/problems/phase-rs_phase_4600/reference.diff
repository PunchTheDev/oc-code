+/// CR 208.3: Combined power of the given objects (treating absent/empty power as 0).
+pub(crate) fn total_power(state: &GameState, ids: &[ObjectId]) -> i32 {
+    ids.iter()
+        .filter_map(|id| state.objects.get(id))
+        .map(|obj| obj.power.unwrap_or(0))
+        .sum()
+}
