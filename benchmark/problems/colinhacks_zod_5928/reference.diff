+    const schema = z.object({ a: z.string(), b: z.number() });
+    const result = visit(schema, { number: () => z.string() }) as z.ZodType;
+    expect(result.parse({ a: "x", b: "y" } as any)).toEqual({ a: "x", b: "y" });
