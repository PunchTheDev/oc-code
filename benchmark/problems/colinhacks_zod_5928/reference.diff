+    const partial = deepPartial(schema);
+    expect(partial.parse({})).toEqual({});
+  });
+
+  test("tuple elements stay required — only *objects inside* become partial", () => {
+    const schema = z.tuple([z.object({ a: z.string() }), z.string()]);
+    const partial = deepPartial(schema);
