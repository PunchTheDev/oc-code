+function csvFilename(filename) {
+  const stem =
+    String(filename || "export")
+      .replace(/\.csv$/i, "")
+      .replace(/[^A-Za-z0-9._-]+/g, "-")
+      .replace(/^-+|-+$/g, "") || "export";
+  return `${stem}.csv`;
+}
+
+export function rowsToCsv(rows, columns) {
+  const safeRows = Array.isArray(rows) ? rows : [];
+  const header = normalizeColumns(safeRows, columns);
+  if (header.length === 0) {
+    return "";
+  }
