+function stringifyCell(value) {
+  if (value === null || value === undefined) {
+    return "";
+  }
+  if (Array.isArray(value)) {
+    return value
+      .map((entry) =>
+        entry && typeof entry === "object" ? JSON.stringify(entry) : entry,
+      )
+      .join(";");
+  }
+  if (typeof value === "object") {
+    return JSON.stringify(value);
+  }
+  return String(value);
