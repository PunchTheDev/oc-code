+function escapeCell(value) {
+  const text = stringifyCell(value);
+  const safeText = SPREADSHEET_FORMULA_PREFIX.test(text) ? `'${text}` : text;
+  if (!/[",\r\n]/.test(safeText)) {
+    return safeText;
+  }
+  return `"${safeText.replaceAll('"', '""')}"`;
