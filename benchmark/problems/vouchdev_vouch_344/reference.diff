+def test_diff_omitted_new_id_for_page_raises(store: KBStore) -> None:
+    store.put_page(Page(id="p1", title="P", body="b"))
+    with pytest.raises(DiffError, match="pages have no successor pointer"):
+        diff_artifacts(store, "p1")
+
