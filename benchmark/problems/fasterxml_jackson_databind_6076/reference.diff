+            // `super` always returns null here (`BeanProperty.Std.getContextAnnotation`), so
+            // delegating to `_enclosing` alone loses nothing when it is null.
+            return (_enclosing == null) ? null : _enclosing.getContextAnnotation(acls);
+        }
+    }
