index 000000000000..e750cd62a002
--- /dev/null
+++ b/changelog/fix_an_incorrect_autocorrect_for_style_redundant_fetch_block_20260920185933.md
@@ -0,0 +1 @@
+* [#15663](https://github.com/rubocop/rubocop/issues/15663): Fix an incorrect autocorrect for `Style/RedundantFetchBlock` when `fetch` is called with a splat, an anonymous rest argument, or keyword arguments. ([@ihamzatarar][])
diff --git a/lib/rubocop/cop/style/redundant_fetch_block.rb b/lib/rubocop/cop/style/redundant_fetch_block.rb
index ea5afb947450..f5c80dcdbde1 100644
--- a/lib/rubocop/cop/style/redundant_fetch_block.rb
+++ b/lib/rubocop/cop/style/redundant_fetch_block.rb
@@ -74,7 +74,8 @@ def on_block(node) # rubocop:disable InternalAffairs/NumblockHandler, InternalAf
         def should_not_check?(send, body)
           (body&.const_type? && !check_for_constant?) ||
             (body&.str_type? && !check_for_string?) ||
-            rails_cache?(send.receiver)
+            rails_cache?(send.receiver) ||
+            unappendable_argument?(send)
         end
 
         # @!method rails_cache?(node)
@@ -107,6 +108,13 @@ def check_for_constant?
         def check_for_string?
           frozen_string_literals_enabled?
         end
+
+        def unappendable_argument?(send)
+          argument = send.first_argument
+
+          argument.type?(:splat, :forwarded_restarg) ||
+            (argument.hash_type? && !argument.braces?)
+        end
       end
     end
   end
diff --git a/spec/rubocop/cop/style/redundant_fetch_block_spec.rb b/spec/rubocop/cop/style/redundant_fetch_block_spec.rb
