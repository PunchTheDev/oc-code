diff --git a/src/twisted/newsfragments/9638.bugfix b/src/twisted/newsfragments/9638.bugfix
new file mode 100644
index 00000000000..37ba462c8cc
--- /dev/null
+++ b/src/twisted/newsfragments/9638.bugfix
@@ -0,0 +1,3 @@
+twisted.logger.LoggingFile.fileno now raises io.UnsupportedOperation
+instead of returning -1.
+This fixes an interoperability issue with multiprocessing.
