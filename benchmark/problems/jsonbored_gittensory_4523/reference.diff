+  closeDefaultClaimLedger();
+  closeDefaultPortfolioQueueStore();
+  closeDefaultEventLedger();
+  for (const db of dbs.splice(0)) db.close();
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true });
+});
