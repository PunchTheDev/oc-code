+    payload = result["result"]
+    assert payload["id"] == cid_target
+    hot = payload["_meta"]["vouch_hot_memory"]
+    assert all(r["id"] != cid_target for r in hot)
+    assert any("jwt expiry" in r["text"] for r in hot)
