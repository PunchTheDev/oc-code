+def test_build_manifest_shape_and_determinism():
+    import json
+
+    s = _splits()
+    m1 = P.build_manifest("math500", s, pool_models=["m"], created_at="2026-01-01T00:00:00Z")
+    m2 = P.build_manifest("math500", s, pool_models=["m"], created_at="2026-01-01T00:00:00Z")
