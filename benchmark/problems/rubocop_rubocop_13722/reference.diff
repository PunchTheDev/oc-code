+        while foo { |x| x }
+        end
+      RUBY
+    end
+
+    it 'accepts a single line block with {} if used in an `until` condition' do
+      expect_no_offenses(<<~RUBY)
+        until foo { |x| x }
+        end
+      RUBY
+    end
+
     it 'accepts a single line block with {} if used in a logical or' do
