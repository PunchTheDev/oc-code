+      "source": "https://github.com/OWNER/heldout-recent-d",
+      "tier": "recent",
+      "held_out": true,
+      "freeze_window": {
+        "after": "2025-11-01",
+        "before": "2026-04-01",
+        "recent_bias": true
+      },
+      "notes": "Held out from tuning; used only to measure generalization (see #52)."
+    },
+    {
+      "name": "heldout-obscure-e",
+      "source": "https://github.com/OWNER/heldout-obscure-e",
+      "tier": "obscure",
+      "held_out": true,
+      "freeze_window": {
