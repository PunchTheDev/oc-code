         ``warnings`` and ``deselected`` are only checked if not None.
+
+        This method requires pytest's standard terminal summary; see
+        :meth:`parseoutcomes`.
         """
         __tracebackhide__ = True
         from _pytest.pytester_assertions import assert_outcomes
