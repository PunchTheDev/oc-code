diff --git a/internal/paramdelim/paramdelim.go b/internal/paramdelim/paramdelim.go
new file mode 100644
index 00000000000..ead0beb0f04
--- /dev/null
+++ b/internal/paramdelim/paramdelim.go
@@ -0,0 +1,17 @@
+// Package paramdelim holds the byte set that ends a ":name" placeholder in a
+// path. The route parser and the HTTP client both need the same grammar; keep
+// it here so they cannot drift (#4635).
+package paramdelim
+
+// PathEndChars are the bytes that terminate a :name placeholder in a URL path
+// or route pattern: '/', '-', '.', ':', '\\', and '?'.
+func PathEndChars() [256]bool {
+	var s [256]bool
+	s['/'] = true
+	s['-'] = true
+	s['.'] = true
+	s[':'] = true
+	s['\\'] = true
+	s['?'] = true
+	return s
+}
diff --git a/internal/paramdelim/paramdelim_test.go b/internal/paramdelim/paramdelim_test.go
new file mode 100644
index 00000000000..3082babd5e9
--- /dev/null
+++ b/internal/paramdelim/paramdelim_test.go
@@ -0,0 +1,23 @@
+package paramdelim
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Test_PathEndChars pins the shared set to the router's grammar: the six bytes
+// that end a ":name", and not '#', which only the client treats as a terminator.
+func Test_PathEndChars(t *testing.T) {
+	t.Parallel()
+
+	set := PathEndChars()
+	for _, c := range []byte{'/', '-', '.', ':', '\\', '?'} {
+		require.True(t, set[c], "%q must end a path parameter", c)
+	}
+	require.False(t, set['#'], "'#' is a client-only terminator")
+
+	// The client adds '#' to what it gets back, so this must hand out a copy.
+	set['#'] = true
+	require.False(t, PathEndChars()['#'])
+}
