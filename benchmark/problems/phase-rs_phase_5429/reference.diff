+                Effect::BecomeCopy { target, .. } => Some(target.clone()),
+                _ => None,
+            })
+            .expect("Copy Enchantment must parse a BecomeCopy clone replacement");
+
+        let targets = find_copy_targets(&state, &filter, source, PlayerId(0), None);
+
+        assert!(
