+          'use strict'
+          this.value = 42
+          exports.isExports = this === module.exports
+        `,
+        'basic.test.js': `
+        import { expect, test } from 'vitest'
+        import commonjs from 'commonjs-this'
+
+        test('this is module.exports', () => {
+          expect(commonjs).toEqual({ value: 42, isExports: true })
+        })
+      `,
+      },
+      { pool },
+    )
+
+    expect(stderr).toBe('')
