       def extract_rbs_inline_value; end
 
+      def extract_warn_indent
+        match(KEYWORDS[:warn_indent])
+      end
+
       def extract_shareable_constant_value
         match(KEYWORDS[:shareable_constant_value])
       end
@@ -258,6 +278,9 @@ def frozen_string_literal; end
