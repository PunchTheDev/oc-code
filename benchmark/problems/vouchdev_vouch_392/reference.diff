+
+def test_manifest_boolean_flags_still_accepted(tmp_path: Path, monkeypatch) -> None:
+    from vouch.install_adapter import _load_manifest
+
+    _write_manifest(tmp_path, "okhost", (
+        "host: okhost\n"
+        "tiers:\n"
+        "  T1:\n"
