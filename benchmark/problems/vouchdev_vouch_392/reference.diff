+def test_merge_toml_reports_no_change_when_subset() -> None:
+    from vouch.install_adapter import _merge_toml
+
+    dst = {"a": {"b": 1, "c": [1, 2]}, "top": "x"}
+    src = {"a": {"b": 999}}  # conflicting value: dst wins, nothing to add
