+        );
+        let mand_exec = mandatory.execute.as_deref().expect("execute");
+        assert!(
+            !mand_exec.optional,
+            "without \"may\" the per-opponent draw is mandatory"
+        );
+        assert_eq!(
+            mand_exec.player_scope,
+            Some(PlayerFilter::OpponentOfTriggeringPlayer)
+        );
+    }
 }
