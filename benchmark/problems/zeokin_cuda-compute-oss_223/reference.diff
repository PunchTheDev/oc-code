-    cfg = config or Config(dtype=_dtype_name(A.dtype), verbose=False)
+    if np.dtype(A.dtype) != np.dtype(B.dtype):
+        raise ValueError(
+            f"A and B must have the same dtype; got {np.dtype(A.dtype)} vs {np.dtype(B.dtype)}"
