+    private fun decodeDoubleQuoted(value: String): String {
+        val out = StringBuilder(value.length)
+        var escaped = false
+        for (char in value) {
+            if (escaped) {
+                out.append(
+                    when (char) {
+                        '\\' -> '\\'
+                        '"' -> '"'
+                        'n' -> '\n'
+                        'r' -> '\r'
+                        't' -> '\t'
+                        else -> char
+                    }
+                )
+                escaped = false
+            } else if (char == '\\') {
+                escaped = true
+            } else {
+                out.append(char)
+            }
+        }
+        if (escaped) out.append('\\')
+        return out.toString()
+    }
