 function coerceFiniteNumber(value: unknown): number | undefined {
   if (typeof value === "number" && Number.isFinite(value)) return value;
@@ -2652,6 +2656,78 @@ export const chainTransferPairsQuery = (
     staleTime: STALE_MED,
