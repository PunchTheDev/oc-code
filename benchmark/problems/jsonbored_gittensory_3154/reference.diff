+test("computeGateVerdictCompositeCalibrationScore averages multiple opted-in repos", () => {
+  const result = computeGateVerdictCompositeCalibrationScore({
+    objectiveAnchor: 0,
+    pairwise: null,
+    gateVerdicts: [
+      {
+        repoFullName: "owner/one",
