+        gateRunId: "gate-9a",
+        optedIn: true,
+        dimensions: [{ dimension: "correctness", outcome: "pass" }],
+      },
+      {
+        repoFullName: "owner/two",
+        replayRunId: "replay-9",
+        gateRunId: "gate-9b",
+        optedIn: true,
+        dimensions: [{ dimension: "correctness", outcome: "fail" }],
+      },
