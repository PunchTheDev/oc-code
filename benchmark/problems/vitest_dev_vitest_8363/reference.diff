+    vi.clearAllMocks()
+    assertStateEmpty(state)
+  })
+
+  test('vi.spyOn() spies and tracks overriden sync class calls with context', () => {
+    const object = createObject()
+    const mock = vi.spyOn(object, 'Class')
+    mock.mockImplementation(class {
+      public value: number
+      constructor() {
+        this.value = 42
+      }
+    })
