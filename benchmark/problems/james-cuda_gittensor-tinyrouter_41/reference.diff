+def test_scoring_still_binary():
+    assert get_adapter("math500").score_output("\\boxed{4}", "4") == 1.0
+    assert get_adapter("math500").score_output("\\boxed{5}", "4") == 0.0
+    assert get_adapter("mmlu").score_output("The answer is B.", "B") == 1.0
