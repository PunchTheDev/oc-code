diff --git a/tests/test_repeatability_gate.py b/tests/test_repeatability_gate.py
index 0e168a86..fc0e3649 100644
--- a/tests/test_repeatability_gate.py
+++ b/tests/test_repeatability_gate.py
@@ -210,6 +210,20 @@ def test_cli_missing_file_exits_two():
     assert proc.returncode == 2
 
 
+def test_cli_rejects_a_directory_path(tmp_path):
+    # A directory raises IsADirectoryError (POSIX) / PermissionError (Windows) from open() --
+    # both are OSError subclasses that must be caught, not just FileNotFoundError.
+    proc = subprocess.run(
+        [sys.executable, "-m", "scripts.repeatability_gate", str(tmp_path)],
+        cwd=ROOT,
+        capture_output=True,
+        text=True,
+    )
+    assert proc.returncode == 2
+    assert "Traceback" not in proc.stderr
+    assert str(tmp_path) in proc.stderr
+
+
 def test_check_repeatability_does_not_mutate_inputs():
     artifacts = [_run(0.6), _run(0.61)]
     snap = copy.deepcopy(artifacts)
diff --git a/tests/test_task_independence.py b/tests/test_task_independence.py
index ee04ea88..142e7d7b 100644
--- a/tests/test_task_independence.py
+++ b/tests/test_task_independence.py
@@ -177,6 +177,17 @@ def test_cli_rejects_a_missing_file(tmp_path):
     assert exc.value.code == 2
 
 
+def test_cli_rejects_a_directory_path(tmp_path, capsys):
+    # A directory raises IsADirectoryError (POSIX) / PermissionError (Windows) from open() --
+    # both are OSError subclasses that must be caught, not just FileNotFoundError.
+    with pytest.raises(SystemExit) as exc:
+        cli.run([str(tmp_path)])
+    assert exc.value.code == 2
+    captured = capsys.readouterr()
+    assert "Traceback" not in captured.err
+    assert str(tmp_path) in captured.err
+
+
 def test_cli_rejects_malformed_json(tmp_path):
     path = tmp_path / "bad.json"
     path.write_text("{not json", encoding="utf-8")
