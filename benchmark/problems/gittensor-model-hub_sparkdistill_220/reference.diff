diff --git a/tests/test_verify.py b/tests/test_verify.py
index 7ed05a2..7063a0e 100644
--- a/tests/test_verify.py
+++ b/tests/test_verify.py
@@ -388,3 +388,64 @@ def test_verify_submission_hopper_tiers_on_triton(tmp_path, monkeypatch):
     assert report["gpu_architecture"] == "hopper"
     assert report["best_benchmark"] == "triton"
     assert report["label"] == "eval:XL"
+
+
+def _malformed_bundle(tmp_path, *, manifest: str, scores: str):
+    bundle = tmp_path / "bundle"
+    bundle.mkdir(parents=True)
+    (bundle / "manifest.json").write_text(manifest, encoding="utf-8")
+    (bundle / "eval_scores.json").write_text(scores, encoding="utf-8")
+    return bundle
+
+
+def test_load_bundle_json_rejects_malformed_and_non_object(tmp_path):
+    from eval.verify import load_bundle_json
+
+    bundle = tmp_path / "b"
+    bundle.mkdir()
+    (bundle / "a.json").write_text("{not json")
+    (bundle / "b.json").write_text("[]")
+    (bundle / "c.json").write_text('{"ok": 1}')
+
+    payload, error = load_bundle_json(bundle, "a.json")
+    assert payload is None and "is not valid JSON" in error
+
+    payload, error = load_bundle_json(bundle, "b.json")
+    assert payload is None and "must be a JSON object, got list" in error
+
+    payload, error = load_bundle_json(bundle, "c.json")
+    assert payload == {"ok": 1} and error is None
+
+
+def test_malformed_proof_bundle_rejects_instead_of_raising(tmp_path):
+    """A miner's published bundle is untrusted input, and the training-track gate
+    calls verify_submission with no try/except — so a bad artifact must come back
+    as eval:REJECT, not TypeError/KeyError/AttributeError/JSONDecodeError.
+    """
+    import json
+
+    from eval.verify import verify_submission
+
+    cases = [
+        ('{"run_id": "r"}', "[]", "eval_scores.json must be a JSON object"),
+        ('{"run_id": "r"}', json.dumps({"oops": 1}), "must contain a 'scores' object"),
+        ('{"run_id": "r"}', "{bad", "eval_scores.json is not valid JSON"),
+        ("[]", json.dumps({"scores": {"gsm8k": 0.5}}), "manifest.json must be a JSON object"),
+        ("{bad", json.dumps({"scores": {"gsm8k": 0.5}}), "manifest.json is not valid JSON"),
+    ]
+    for index, (manifest, scores, expected) in enumerate(cases):
+        bundle = _malformed_bundle(tmp_path / f"case{index}", manifest=manifest, scores=scores)
+        report = verify_submission(bundle, frontier=None)
+        assert report["verified"] is False
+        assert report["reason"] == "malformed_bundle"
+        assert report["label"] == "eval:REJECT"
+        assert any(expected in issue for issue in report["issues"]), (expected, report["issues"])
+
+
+def test_malformed_bundle_reports_run_id_when_manifest_is_readable(tmp_path):
+    import json
+
+    from eval.verify import verify_submission
+
+    bundle = _malformed_bundle(tmp_path, manifest=json.dumps({"run_id": "r-42"}), scores="[]")
+    assert verify_submission(bundle, frontier=None)["run_id"] == "r-42"
