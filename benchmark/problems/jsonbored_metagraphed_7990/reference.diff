+        name: "String",
+        ofType: null,
+      });
+    }
+    for (const name of [
+      "spec_version",
+      "block_start",
+      "block_end",
+      "min_extrinsics",
+      "min_events",
+    ]) {
+      assert.deepEqual(argType(name), {
+        kind: "SCALAR",
+        name: "Int",
+        ofType: null,
+      });
+    }
+  });
